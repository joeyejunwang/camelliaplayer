# Uncomment this line to define a global platform for your project
platform :ios, '15.0'

# CocoaPods analytics is not needed when a workspace is generated by the Flutter tool.
# The following is a workaround to ensure iOS simulators can run Flutter apps
# that don't have a unique build setting for each simulator.

ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure flutter pub get is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Generated.xcconfig, then run flutter pub get"
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_ios_podfile_setup

target 'Runner' do
  use_frameworks!
  use_modular_headers!

  flutter_install_all_ios_pods File.dirname(File.realpath(__FILE__))
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_ios_build_settings(target)
  end

  # CocoaPods 1.16+ double-injects `POD_CONFIGURATION_*` macros into each
  # Pod's compile command line (once via the generated xcconfig and once
  # via OTHER_CFLAGS), producing a wall of "macro redefined" warnings.
  # Strip the duplicate from both places, handle both `-DFOO=1` and
  # `-D "FOO=1"` (quoted) forms, fall back to `$(inherited)` if the
  # array becomes empty, and add `-Wno-macro-redefined` as a safety net.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      # 1. Strip from GCC_PREPROCESSOR_DEFINITIONS.
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      defs.reject! { |d| d.to_s.include?('POD_CONFIGURATION_') }
      defs = ['$(inherited)'] if defs.empty?
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs

      # 2. Strip `-DPOD_CONFIGURATION_*` (and `-D "POD_CONFIGURATION_*"`)
      #    from C/C++/Swift flag arrays.
      ['OTHER_CFLAGS', 'OTHER_CPLUSPLUSFLAGS', 'OTHER_SWIFT_FLAGS'].each do |key|
        flags = config.build_settings[key] || ['$(inherited)']
        flags = [flags] unless flags.is_a?(Array)
        flags.reject! do |flag|
          s = flag.to_s
          s.include?('POD_CONFIGURATION_') &&
            (s.start_with?('-D') || s =~ /-D\s*POD_CONFIGURATION_/)
        end
        flags = ['$(inherited)'] if flags.empty?
        config.build_settings[key] = flags
      end
    end
  end

  # 3. Belt-and-suspenders: silence any remaining macro-redefined warning.
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      unless config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] == 'YES'
        existing = config.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
        existing = [existing] unless existing.is_a?(Array)
        existing << '-Wno-macro-redefined'
        config.build_settings['WARNING_CFLAGS'] = existing
      end
    end
  end

  # Suppress warnings for `PrivacyInfo.xcprivacy` files that some
  # third-party packages ship without declaring them in their podspec
  # resource files (notably volume_controller 3.7.1).
  installer.pods_project.targets.each do |target|
    target.build_configurations.each do |config|
      unless config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] == 'YES'
        existing = config.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
        existing = [existing] unless existing.is_a?(Array)
        existing << '-Wno-unknown-warning'
        existing << '-Wno-unknown-warning-option'
        config.build_settings['WARNING_CFLAGS'] = existing
      end
    end
  end
end
