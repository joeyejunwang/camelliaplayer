platform :osx, '10.15'

# CocoaPods analytics sends network stats synchronously affecting flutter build latency.
ENV['COCOAPODS_DISABLE_STATS'] = 'true'

project 'Runner', {
  'Debug' => :debug,
  'Profile' => :release,
  'Release' => :release,
}

def flutter_root
  generated_xcode_build_settings_path = File.expand_path(File.join('..', 'Flutter', 'ephemeral', 'Flutter-Generated.xcconfig'), __FILE__)
  unless File.exist?(generated_xcode_build_settings_path)
    raise "#{generated_xcode_build_settings_path} must exist. If you're running pod install manually, make sure \"flutter pub get\" is executed first"
  end

  File.foreach(generated_xcode_build_settings_path) do |line|
    matches = line.match(/FLUTTER_ROOT\=(.*)/)
    return matches[1].strip if matches
  end
  raise "FLUTTER_ROOT not found in #{generated_xcode_build_settings_path}. Try deleting Flutter-Generated.xcconfig, then run \"flutter pub get\""
end

require File.expand_path(File.join('packages', 'flutter_tools', 'bin', 'podhelper'), flutter_root)

flutter_macos_podfile_setup

target 'Runner' do
  use_frameworks!

  flutter_install_all_macos_pods File.dirname(File.realpath(__FILE__))
  target 'RunnerTests' do
    inherit! :search_paths
  end
end

post_install do |installer|
  installer.pods_project.targets.each do |target|
    flutter_additional_macos_build_settings(target)
    # CocoaPods 1.16+ double-injects `POD_CONFIGURATION_*` macros into the
    # compiler command line, which produces "macro redefined" warnings on
    # every Pod. Strip the GCC_PREPROCESSOR_DEFINITIONS entries CocoaPods
    # adds; the -D flag that Flutter injects is enough.
    target.build_configurations.each do |config|
      defs = config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] || ['$(inherited)']
      defs = [defs] unless defs.is_a?(Array)
      defs.reject! { |d| d.to_s.start_with?('POD_CONFIGURATION_') }
      config.build_settings['GCC_PREPROCESSOR_DEFINITIONS'] = defs
    end
    # Suppress warnings for `PrivacyInfo.xcprivacy` files that some
    # third-party packages ship without declaring in their podspec
    # resource files (notably volume_controller 3.7.1).
    target.build_configurations.each do |config|
      warned = config.build_settings['GCC_WARN_INHIBIT_ALL_WARNINGS'] == 'YES'
      unless warned
        existing = config.build_settings['WARNING_CFLAGS'] || ['$(inherited)']
        existing = [existing] unless existing.is_a?(Array)
        existing << '-Wno-unknown-warning'
        # Hide the specific "no rule to process file" diagnostic.
        existing << '-Wno-unknown-warning-option'
        config.build_settings['WARNING_CFLAGS'] = existing
      end
    end
  end
end
